{
  "dependencies": {
    "madr": "^4.0.0"
  },
  "name": "gymtracker",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend",
    "db:dev": "npm run db:dev -w backend",
    "db:seed": "npm run seed -w backend",
    "db:generate": "npm run db:generate -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
