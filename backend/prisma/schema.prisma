generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  TRAINER
  ADMIN
}

enum TrainerLinkStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id               String              @id @default(uuid()) @db.Uuid
  email            String              @unique
  passwordHash     String              @map("password_hash")
  displayName      String              @map("display_name")
  role             Role                @default(MEMBER)
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  trainerLinks     TrainerLink[]       @relation("Trainer")
  memberLinks      TrainerLink[]       @relation("Member")
  programs         WorkoutProgram[]
  assignments      ProgramAssignment[] @relation("AssignedMember")
  assignedPrograms ProgramAssignment[] @relation("AssignedBy")
  authSessions     AuthSession[]
  sessions         WorkoutSession[]

  @@map("users")
}

model TrainerLink {
  id        String            @id @default(uuid()) @db.Uuid
  trainerId String            @map("trainer_id") @db.Uuid
  memberId  String            @map("member_id") @db.Uuid
  status    TrainerLinkStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  trainer   User              @relation("Trainer", fields: [trainerId], references: [id], onDelete: Restrict)
  member    User              @relation("Member", fields: [memberId], references: [id], onDelete: Restrict)

  @@index([trainerId, memberId, status])
  @@index([memberId, status])
  @@map("trainer_links")
}

model Exercise {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  muscleGroup      String            @map("muscle_group")
  equipment        String
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  programExercises ProgramExercise[]
  sessionSets      SessionSet[]

  @@map("exercises")
}

model WorkoutProgram {
  id          String              @id @default(uuid()) @db.Uuid
  ownerId     String              @map("owner_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  days        ProgramDay[]
  assignments ProgramAssignment[]

  @@index([ownerId])
  @@map("workout_programs")
}

model ProgramDay {
  id        String            @id @default(uuid()) @db.Uuid
  programId String            @map("program_id") @db.Uuid
  dayNumber Int               @map("day_number")
  title     String
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  program   WorkoutProgram    @relation(fields: [programId], references: [id], onDelete: Restrict)
  exercises ProgramExercise[]
  sessions  WorkoutSession[]

  @@unique([programId, dayNumber])
  @@map("program_days")
}

model ProgramExercise {
  id             String     @id @default(uuid()) @db.Uuid
  dayId          String     @map("day_id") @db.Uuid
  exerciseId     String     @map("exercise_id") @db.Uuid
  position       Int
  targetSets     Int        @map("target_sets")
  targetReps     Int        @map("target_reps")
  targetWeightKg Decimal?   @map("target_weight_kg") @db.Decimal(6, 2)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  day            ProgramDay @relation(fields: [dayId], references: [id], onDelete: Restrict)
  exercise       Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([dayId, position])
  @@index([exerciseId])
  @@map("program_exercises")
}

model ProgramAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  programId    String           @map("program_id") @db.Uuid
  memberId     String           @map("member_id") @db.Uuid
  assignedById String           @map("assigned_by") @db.Uuid
  assignedAt   DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  program      WorkoutProgram   @relation(fields: [programId], references: [id], onDelete: Restrict)
  member       User             @relation("AssignedMember", fields: [memberId], references: [id], onDelete: Restrict)
  assignedBy   User             @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  sessions     WorkoutSession[]

  @@index([programId])
  @@index([memberId])
  @@index([assignedById])
  @@map("program_assignments")
}

model WorkoutSession {
  id           String             @id @default(uuid()) @db.Uuid
  memberId     String             @map("member_id") @db.Uuid
  assignmentId String?            @map("assignment_id") @db.Uuid
  programDayId String             @map("program_day_id") @db.Uuid
  planSnapshot Json?              @map("plan_snapshot") @db.JsonB
  status       WorkoutStatus      @default(IN_PROGRESS)
  startedAt    DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?          @map("finished_at") @db.Timestamptz(6)
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  member       User               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  assignment   ProgramAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  programDay   ProgramDay         @relation(fields: [programDayId], references: [id], onDelete: Restrict)
  sets         SessionSet[]

  @@index([memberId, startedAt])
  @@index([assignmentId])
  @@index([programDayId])
  @@map("workout_sessions")
}

model SessionSet {
  id               String         @id @default(uuid()) @db.Uuid
  sessionId        String         @map("session_id") @db.Uuid
  exerciseId       String         @map("exercise_id") @db.Uuid
  exercisePosition Int            @map("exercise_position")
  setNumber        Int            @map("set_number")
  reps             Int
  weightKg         Decimal?       @map("weight_kg") @db.Decimal(6, 2)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  session          WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, exercisePosition, setNumber])
  @@index([exerciseId])
  @@map("session_sets")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
